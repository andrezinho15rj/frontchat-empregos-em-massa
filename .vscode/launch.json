{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontchat (app)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONUTF8": "1"
            }
        },
        {
            "name": "Frontchat (testes)",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s",
                "tests",
                "-t",
                "."
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONUTF8": "1",
                "QT_QPA_PLATFORM": "offscreen"
            }
        }
    ]
}
